    {
      "name": "猜·问分数",
      "chapter": "1-4",
      "precondition_names": [],
      "condition": {
        "operator": "and",
        "rules": [
          {
            "key": "选择:猜·那块亮的东西",
            "comparator": "==",
            "value": 0,
            "metric": "last"
          }
