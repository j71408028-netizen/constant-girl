    {
      "name": "边缘·有人上来",
      "chapter": "2-1",
      "precondition_names": [],
      "condition": {
        "operator": "and",
        "rules": [
          {
            "key": "节内计数",
            "comparator": ">=",
            "value": 2
          },
          {
            "key": "介入度",
