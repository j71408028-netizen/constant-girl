    {
      "name": "猜·跟了一段",
      "chapter": "1-4",
      "precondition_names": [],
      "condition": {
        "operator": "and",
        "rules": [
          {
            "key": "选择:猜·不要跟",
            "comparator": "==",
            "value": 0,
            "metric": "last"
          }
        ]
      },
      "repeatable": false,
      "action_type": "insert",
      "action_data": {
        "type": "insert",
        "text_type": "branch",
        "highlight": false,
        "delayed": false,
        "text": "我跟了她一段。她走得比我快，也从不回头看我在不在。\n走到第三道坡，她停下，没有转身。\n@饥饿游戏@“你跟着我，我就得替你看着脚下。”\n@饥饿游戏@“我不干这个。”\n她说完就走了。我站在原地，等她的背影小到看不见，才转回东边。"
      }
    },
    {
      "name": "猜·往东",
      "chapter": "1-4",
      "precondition_names": [],
      "condition": {
        "operator": "and",
        "rules": [
          {
            "key": "选择:猜·不要跟",
            "comparator": "==",
            "value": 1,
            "metric": "last"
          }
        ]
