      "repeatable": false,
      "action_type": "option",
      "action_data": {
        "type": "option",
        "prompt": "她要往西走。回稳会在东边。她没有劝，只是把那块东西收进衣兜，站在那儿，等一个决定。",
        "options": [
          {
            "id": 0,
            "prompt": "跟上去。她手里的东西会说明该怎么办",
